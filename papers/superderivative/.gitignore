# Python virtual environment
.venv/
__pycache__/
*.pyc

# LaTeX auxiliary files
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
*.bbl
*.blg

# OS files
.DS_Store
Thumbs.db

# BSDS500 dataset: 140 MB of images and ground truth, redownloadable.
# src/official_bsds/eval_bsds500_official_code.py expects it unpacked at
# data/BSR/BSDS500/.
data/BSR/
data/BSR_bsds500.tgz
*.tgz
bench/
*.mat

# Generated figures written into src/ by a script run from the wrong directory.
# The paper only ever reads the top-level figures/.
src/figures/
src/figures/**/*.png
src/figures/**/*.pdf
src/figures/**/*.jpg
src/figures/**/*.jpeg
src/figures/**/*.svg

# Official matching build artifact and resumable per-image cache.
src/official_bsds/libcorrespond.so
src/official_bsds/cache/

# Python build, test and tooling artifacts.
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Additional LaTeX auxiliary files.
*.synctex(busy)
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.lof
*.lot
*.xdv

# Editor files
.vscode/
.idea/
